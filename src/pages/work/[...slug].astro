---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, year, role, tags, cover, coverAlt, links, context } = project.data;
const { Content } = await render(project);
---
<Base title={`${title} — Marcus Tian`} description={summary}>
  <article>
    <header class="head wrap" id="top">
      <a href="/#work" class="back">
        <svg class="ico" viewBox="0 0 16 16"><use href="#i-back" /></svg> All work
      </a>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>

      <dl class="facts">
        <div><dt>Role</dt><dd>{role}</dd></div>
        {year && <div><dt>Year</dt><dd class="num">{year}</dd></div>}
        {context && <div><dt>Context</dt><dd>{context}</dd></div>}
      </dl>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>

    {cover && (
      <div class="cover wrap">
        <Image src={cover} alt={coverAlt ?? ''} widths={[760, 1200, 1800]}
               sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" />
      </div>
    )}

    <div class="body wrap">
      <div class="prose"><Content /></div>

      {links.length > 0 && (
        <aside class="links">
          <h2>References</h2>
          <ul>
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label} <svg class="ico" viewBox="0 0 16 16"><use href="#i-arr" /></svg>
                  <span class="sr">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <nav class="next wrap">
      <a href={`/work/${next.id}/`}>
        <span class="next__label">Next project</span>
        <span class="next__title">{next.data.title}</span>
        <svg class="ico" viewBox="0 0 16 16"><use href="#i-arr" /></svg>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head { padding-top: clamp(7rem, 16vh, 10rem); padding-bottom: 2.5rem; }
  .back { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.85rem;
    color: var(--text-faint); transition: color var(--swift) var(--ease); }
  .back:hover { color: var(--text); }
  h1 { font-size: clamp(2.2rem, 5.6vw, 4rem); font-weight: 500; letter-spacing: -0.03em;
    line-height: 1.02; margin-top: 1.5rem; max-width: 18ch; text-wrap: balance; }
  .lede { margin-top: 1.5rem; max-width: var(--measure); font-size: clamp(1rem, 1.4vw, 1.16rem);
    color: var(--text-soft); line-height: 1.66; }

  .facts { margin-top: 2.75rem; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.5rem;
    border-top: 1px solid var(--hairline); padding-top: 1.5rem; }
  .facts dt { font-family: var(--font-data); font-size: 0.78rem; color: var(--text-faint);
    margin-bottom: 0.35rem; }
  .facts dd { font-size: 0.94rem; color: var(--text-soft); line-height: 1.5; }
  .head .tags { margin-top: 1.75rem; }

  .cover { margin-top: 1rem; }
  /* Cap the banner so a tall phone photo cannot render 2400px high. 760px lets a
     typical 16:10 screenshot show in full at 1200px wide, and crops anything taller
     to the same band, so every case study opens at a consistent height. */
  .cover :global(img) { width: 100%; max-height: 760px; object-fit: cover;
    object-position: center 30%; border: 1px solid var(--hairline); border-radius: var(--r); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 270px;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
    padding-block: clamp(3.5rem, 8vh, 5.5rem); }

  /* Text keeps a comfortable reading measure. Figures use the whole column:
     a journey map or a row of six screens is unreadable squeezed into 68ch. */
  .prose { max-width: none; }
  .prose :global(h2), .prose :global(p), .prose :global(ul),
  .prose :global(blockquote) { max-width: var(--measure); }
  .prose :global(h2) { font-size: clamp(1.4rem, 2.4vw, 1.85rem); font-weight: 500;
    letter-spacing: -0.026em; line-height: 1.18; margin-top: 3rem; margin-bottom: 0.9rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { color: var(--text-soft); font-size: 1.02rem; line-height: 1.78;
    margin-bottom: 1.1rem; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(em) { color: var(--text); font-style: italic; }
  .prose :global(ul) { margin: 0 0 1.4rem 1.1rem; color: var(--text-soft); }
  .prose :global(li) { margin-bottom: 0.6rem; line-height: 1.72; }
  .prose :global(li::marker) { color: var(--text-faint); }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); padding-left: 1.1rem;
    margin: 1.75rem 0; color: var(--text-soft); }
  .prose :global(blockquote p) { margin-bottom: 0.5rem; }
  .prose :global(p:has(img)) { margin: 2.25rem 0 0.75rem; max-width: none; }
  /* Full frame, never cropped -- but a tall phone photo is capped to the viewport
     so it does not become a 1300px scroll. Wide screenshots are unaffected. */
  .prose :global(img) { max-width: 100%; max-height: 78vh; width: auto; height: auto;
    margin-inline: auto; border: 1px solid var(--hairline);
    border-radius: var(--r); background: var(--surface); }
  .prose :global(p:has(img) + p) { font-size: 0.88rem; color: var(--text-faint);
    margin-bottom: 2.25rem; max-width: var(--measure); }
  .prose :global(a) { color: var(--accent); text-underline-offset: 0.22em;
    text-decoration: underline; text-decoration-thickness: 1px; }

  .links { position: sticky; top: 5.5rem; border: 1px solid var(--hairline);
    border-radius: var(--r); padding: 1.35rem 1.4rem; background: var(--surface); }
  .links h2 { font-family: var(--font-data); font-size: 0.78rem; color: var(--text-faint);
    font-weight: 400; margin-bottom: 0.9rem; }
  .links ul { list-style: none; display: grid; gap: 0.7rem; }
  .links a { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem;
    color: var(--text-soft); transition: color var(--swift) var(--ease); }
  .links a:hover { color: var(--accent); }
  .sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .next { border-top: 1px solid var(--hairline); padding-block: 2.5rem 4rem; }
  .next a { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
  .next__label { font-family: var(--font-data); font-size: 0.78rem; color: var(--text-faint); }
  .next__title { font-size: clamp(1.3rem, 2.6vw, 1.9rem); font-weight: 500;
    letter-spacing: -0.026em; transition: color var(--swift) var(--ease); }
  .next a:hover .next__title { color: var(--accent); }

  @media (max-width: 900px) {
    .body { grid-template-columns: 1fr; }
    .links { position: static; }
  }
</style>
