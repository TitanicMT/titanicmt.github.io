{
  // Static-assets-only Worker. No script: Astro's build output in ./dist is
  // served directly.
  //
  // "name" must match the existing Worker exactly. A different value here
  // would deploy to a *different* Worker -- which is how a portfolio deploy
  // could overwrite an unrelated live product.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
